{
  "type": "symfony-bundle",
  "name": "kachnitel/components-bundle",
  "keywords": ["symfony-ux", "twig-component", "dialog", "calendar", "timer"],
  "authors": [
    {
      "name": "Ondrej Vana",
      "email": "kachnitel@gmail.com"
    }
  ],
  "description": "A Symfony bundle for reusable Twig components",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "symfony/framework-bundle": "^6.4|^7.0|^8.0",
    "symfony/ux-twig-component": "^2.21",
    "symfony/ux-live-component": "^2.21",
    "symfony/stimulus-bundle": "^2.21"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "symfony/phpunit-bridge": "^7.0|^8.0",
    "symfony/browser-kit": "^7.0|^8.0",
    "symfony/css-selector": "^7.0|^8.0",
    "symfony/twig-bundle": "^7.0|^8.0",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpmd/phpmd": "^2.15"
  },
  "autoload": {
    "psr-4": {
      "Kachnitel\\ComponentsBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kachnitel\\ComponentsBundle\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "phpunit": "phpunit",
    "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-html .coverage",
    "phpstan": "phpstan analyse --level=6 --memory-limit=1G",
    "phpmd": "phpmd src,tests text phpmd.xml",
    "test": [
      "@phpstan",
      "@phpmd",
      "@phpunit"
    ]
  }
}
